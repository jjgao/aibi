          "maxLength": 200,
          "title": "Data",
          "type": "string",
          "x-aibi-data": true
        },
        "truncated": {
          "const": true,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "data"
      ],
      "title": "DataSegment",
      "type": "object"
    },
    "Derivation": {
      "additionalProperties": false,
      "description": "What an output was computed from, all of it hashed into its id (SPEC §7.6).",
      "properties": {
        "analysis": {
          "$ref": "#/$defs/AnalysisRef"
        },
        "disclosure": {
          "$ref": "#/$defs/Disclosure"
        },
        "document": {
          "additionalProperties": {
            "$ref": "#/$defs/OutputJson"
          },
          "title": "Document",
          "type": "object",
          "x-aibi-data": true
        },
        "engine": {
          "pattern": "^aibi [0-9A-Za-z.+!_-]{1,64}$",
          "title": "Engine",
          "type": "string"
        },
        "id": {
          "pattern": "^drv:[0-9a-f]{64}$",
          "title": "Id",
          "type": "string"
        },
        "packs": {
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,63}$": {
              "$ref": "#/$defs/PackVersion"
            }
          },
          "propertyNames": {
            "maxLength": 64,
            "not": {
              "anyOf": [
                {
                  "pattern": "__"
                },
                {
                  "enum": [
                    "cohort",
                    "compare",
                    "core",
                    "cov",
                    "covered",
                    "dataset",
                    "drv",
                    "ep",
                    "exists",
                    "ids",
                    "iss",
                    "leaf",
                    "model",
                    "rel",
                    "sha256",
                    "stat",
                    "summary",
                    "survival",
                    "value"
                  ]
                }
              ]
            }
          },
          "title": "Packs",
          "type": "object"
        },
        "releases": {
          "items": {
            "$ref": "#/$defs/ReleaseRef"
          },
          "minItems": 1,
          "title": "Releases",
          "type": "array"
        },
        "semantics_version": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Semantics Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "document",
        "analysis",
        "releases",
        "packs",
        "semantics_version",
        "disclosure",
        "engine"
      ],
      "title": "Derivation",
      "type": "object"
    },
    "Disclosure": {
      "additionalProperties": false,
      "description": "The effective disclosure setting of an output (SPEC §8.4).",
      "properties": {
        "min_cell_count": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Min Cell Count"
        }
      },
      "required": [
        "min_cell_count"
      ],
      "title": "Disclosure",
      "type": "object"
    },
    "ExclusionReason": {
      "description": "Why an analysis left out a unit or row (SPEC §6.6): the reasons, and two more.",
      "enum": [
        "NOT_ASSESSED",
        "NOT_COVERED",
        "NO_INFORMATION",
        "NO_PARENT",
        "OUT_OF_SCOPE",
        "NO_ROWS",
        "NOT_APPLICABLE",
        "INVALID_VALUE"
      ],
      "title": "ExclusionReason",
      "type": "string"
    },
    "Issuance": {
      "additionalProperties": false,
      "description": "One time an output was produced. ``values_from`` names the issuance whose SQL produced\nthe values: this one, or for a cache hit the one that filled the cache.",
      "properties": {
        "cache_hit": {
          "title": "Cache Hit",
          "type": "boolean"
        },
        "id": {
          "pattern": "^iss:[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Id",
          "type": "string"
        },
        "values_from": {
          "pattern": "^iss:[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Values From",
          "type": "string"
        }
      },
      "required": [
        "id",
        "cache_hit",
        "values_from"
      ],
      "title": "Issuance",
      "type": "object"
    },
    "OutputJson": {
      "anyOf": [
        {
          "type": [
            "string",
            "boolean",
            "null"
          ]
        },
        {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "number"
        },
        {
          "items": {
            "$ref": "#/$defs/OutputJson"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/OutputJson"
          },
          "type": "object"
        }
