            }
          },
          "then": {
            "properties": {
              "severity": {
                "const": "info"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "LIFT_DIFFERS"
              }
            }
          },
          "then": {
            "properties": {
              "severity": {
                "const": "info"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "POOLED_ACROSS_DATASETS"
              }
            }
          },
          "then": {
            "properties": {
              "severity": {
                "const": "info"
              }
            }
          }
        }
      ],
      "description": "``affects`` holds JSON Pointers relative to the output's root, sorted and de-duplicated.",
      "properties": {
        "affects": {
          "items": {
            "maxLength": 16384,
            "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
            "type": "string",
            "x-aibi-data": true
          },
          "title": "Affects",
          "type": "array"
        },
        "code": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,63}\\.[A-Z][A-Z0-9_]{0,63}$"
            },
            {
              "enum": [
                "UNKNOWN_EXCLUDED",
                "INVALID_EXCLUDED",
                "SCOPE_PARTIAL",
                "COVERAGE_PROPOSED",
                "UNCONFIRMED_SEMANTICS",
                "UNMAPPED_COMPARISON",
                "TIME_ORIGIN_MISMATCH",
                "CONFOUNDED_WITH_DATASET",
                "COHORTS_OVERLAP",
                "SMALL_N",
                "PH_VIOLATED",
                "DRAFT_RELEASE",
                "SUPPRESSED",
                "NOT_ESTIMABLE",
                "LIFT_DIFFERS",
                "POOLED_ACROSS_DATASETS"
              ]
            }
          ],
          "maxLength": 129,
          "not": {
            "anyOf": [
              {
                "pattern": "__"
              },
              {
                "pattern": "^(?:cohort|compare|core|cov|covered|dataset|drv|ep|exists|ids|iss|leaf|model|rel|sha256|stat|summary|survival|value)\\."
              }
            ]
          },
          "pattern": "^(?:[a-z][a-z0-9_]{0,63}\\.)?[A-Z][A-Z0-9_]{0,63}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/TextSegment"
              },
              {
                "$ref": "#/$defs/DataSegment"
              }
            ]
          },
          "title": "Message",
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "affects"
      ],
      "title": "Caveat",
      "type": "object"
    },
