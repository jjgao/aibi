              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "TIME_ORIGIN_MISMATCH"
              }
            }
          },
          "then": {
            "properties": {
              "severity": {
                "const": "block"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "CONFOUNDED_WITH_DATASET"
