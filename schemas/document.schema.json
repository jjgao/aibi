    "ValueLeaf": {
      "additionalProperties": false,
      "description": "A value predicate (SPEC §6.4): exactly one of ``values``, ``range`` or ``op`` + ``value``.",
      "properties": {
        "column": {
          "pattern": "^(?:[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?\\.[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?|[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?:[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?(?:\\.[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?)*)$",
          "title": "Column",
          "type": "string"
        },
        "kind": {
          "const": "value",
          "title": "Kind",
          "type": "string"
        },
        "lift": {
          "enum": [
            "strict",
            "assessed"
          ],
          "title": "Lift",
          "type": "string"
        },
        "match": {
          "enum": [
            "any",
            "all"
          ],
          "title": "Match",
          "type": "string"
        },
        "negate": {
          "default": false,
          "title": "Negate",
          "type": "boolean"
        },
        "op": {
          "enum": [
            "=",
            "!=",
            ">",
            ">=",
            "<",
            "<="
          ],
          "title": "Op",
          "type": "string"
        },
        "quantifier": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "enum": [
                    "some",
                    "every"
                  ],
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/SomeAtLeast"
                }
              ]
            },
            {
              "items": {
                "oneOf": [
                  {
                    "enum": [
                      "some",
                      "every"
                    ],
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/SomeAtLeast"
                  }
                ]
              },
              "minItems": 1,
              "type": "array"
            }
          ],
          "title": "Quantifier"
        },
        "range": {
          "$ref": "#/$defs/Range"
        },
        "units": {
          "pattern": "^[!-~]{1,64}$",
          "title": "Units",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": [
            "string",
            "boolean",
            "number"
          ]
        },
        "values": {
          "items": {
            "type": [
              "string",
              "boolean",
              "number"
            ]
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        },
        "via": {
