        "lift": {
          "enum": [
            "strict",
            "assessed"
          ],
          "title": "Lift",
          "type": "string"
        },
        "min_count": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Min Count",
          "type": "integer"
        },
        "quantifier": {
          "oneOf": [
