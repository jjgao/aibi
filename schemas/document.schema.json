  "$id": "document.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An analysis document after ``params`` substitution (SPEC §7.1).",
  "properties": {
    "aibi": {
      "const": "1",
      "title": "Aibi",
      "type": "string"
    },
    "cohorts": {
      "maxProperties": 6,
      "minProperties": 1,
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_]*$": {
          "$ref": "#/$defs/Cohort"
        }
      },
      "title": "Cohorts",
      "type": "object"
    },
    "dataset": {
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?(?:@(?:[1-9][0-9]*|sha256:[0-9a-f]{64}|draft))?$",
      "title": "Dataset",
      "type": "string"
    },
    "drafted_by": {
      "pattern": "^(?:model:[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?|(?:agent|operator):[^\\x00-\\x1f\\x7f]{1,200})$",
      "title": "Drafted By",
      "type": "string",
      "x-aibi-data": true
    },
    "notes": {
      "maxLength": 10000,
      "title": "Notes",
      "type": "string",
      "x-aibi-data": true
    },
