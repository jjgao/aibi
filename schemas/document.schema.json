          "type": "string"
        },
        "lift": {
          "enum": [
            "strict",
            "assessed"
          ],
          "title": "Lift",
          "type": "string"
        },
        "scope": {
          "minProperties": 1,
          "patternProperties": {
            "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?$": {
              "items": {
                "type": [
                  "string",
                  "boolean",
                  "number"
                ]
              },
              "maxItems": 10000,
              "minItems": 1,
              "type": "array"
            }
          },
          "title": "Scope",
          "type": "object"
        },
        "table": {
          "pattern": "^(?:[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?|[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?:[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?(?:\\.[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?)*)$",
          "title": "Table",
          "type": "string"
        },
        "via": {
          "oneOf": [
            {
              "items": {
                "$ref": "#/$defs/Step"
              },
              "maxItems": 16,
              "type": "array"
            },
            {
              "patternProperties": {
                "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?$": {
                  "items": {
                    "$ref": "#/$defs/Step"
                  },
                  "maxItems": 16,
                  "type": "array"
                }
              },
              "type": "object"
            }
          ],
          "title": "Via"
        }
      },
      "required": [
        "kind",
        "table"
      ],
      "title": "CoveredLeaf",
      "type": "object"
    },
    "ExistsLeaf": {
      "additionalProperties": false,
      "description": "An existence question (SPEC §6.5); ``where`` clauses are ANDed per row of ``table``.",
      "properties": {
        "exclude_self": {
          "default": false,
