{
  "$defs": {
    "AllClause": {
      "additionalProperties": false,
      "properties": {
        "all": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/ValueLeaf"
              },
              {
                "$ref": "#/$defs/ExistsLeaf"
              },
              {
                "$ref": "#/$defs/CoveredLeaf"
              },
              {
                "$ref": "#/$defs/IdsLeaf"
              },
              {
                "$ref": "#/$defs/CohortLeaf"
              },
              {
                "$ref": "#/$defs/PackLeaf"
              },
              {
                "$ref": "#/$defs/AllClause"
              },
              {
                "$ref": "#/$defs/AnyClause"
              },
              {
                "$ref": "#/$defs/NotClause"
              },
              {
                "$ref": "#/$defs/KnownClause"
              },
              {
                "$ref": "#/$defs/UnknownClause"
              }
            ]
          },
          "maxItems": 256,
          "title": "All",
          "type": "array"
        }
      },
      "required": [
        "all"
      ],
      "title": "AllClause",
      "type": "object"
    },
    "AnyClause": {
      "additionalProperties": false,
      "properties": {
        "any": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/ValueLeaf"
              },
              {
                "$ref": "#/$defs/ExistsLeaf"
              },
              {
                "$ref": "#/$defs/CoveredLeaf"
              },
              {
                "$ref": "#/$defs/IdsLeaf"
              },
              {
                "$ref": "#/$defs/CohortLeaf"
              },
              {
                "$ref": "#/$defs/PackLeaf"
              },
              {
                "$ref": "#/$defs/AllClause"
              },
              {
                "$ref": "#/$defs/AnyClause"
              },
              {
                "$ref": "#/$defs/NotClause"
              },
              {
                "$ref": "#/$defs/KnownClause"
              },
              {
                "$ref": "#/$defs/UnknownClause"
              }
            ]
          },
          "maxItems": 256,
          "title": "Any",
          "type": "array"
        }
      },
      "required": [
        "any"
      ],
      "title": "AnyClause",
      "type": "object"
    },
    "Cohort": {
      "additionalProperties": false,
      "description": "A cohort. Duplicate datasets are refused by the document checks, with their paths.",
      "not": {
        "required": [
          "dataset",
          "datasets"
        ]
      },
      "properties": {
        "all": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/ValueLeaf"
              },
              {
                "$ref": "#/$defs/ExistsLeaf"
              },
              {
                "$ref": "#/$defs/CoveredLeaf"
              },
              {
                "$ref": "#/$defs/IdsLeaf"
              },
              {
                "$ref": "#/$defs/CohortLeaf"
              },
              {
                "$ref": "#/$defs/PackLeaf"
              },
              {
                "$ref": "#/$defs/AllClause"
              },
              {
                "$ref": "#/$defs/AnyClause"
              },
              {
                "$ref": "#/$defs/NotClause"
              },
              {
                "$ref": "#/$defs/KnownClause"
              },
              {
                "$ref": "#/$defs/UnknownClause"
              }
            ]
          },
          "maxItems": 256,
          "title": "All",
          "type": "array"
        },
        "dataset": {
          "maxLength": 136,
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?(?:@(?:[1-9][0-9]*|sha256:[0-9a-f]{64}|draft))?$",
          "title": "Dataset",
          "type": "string"
        },
        "datasets": {
          "items": {
            "maxLength": 136,
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?(?:@(?:[1-9][0-9]*|sha256:[0-9a-f]{64}|draft))?$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 2,
          "title": "Datasets",
          "type": "array",
          "uniqueItems": true
        },
        "notes": {
          "maxLength": 10000,
          "title": "Notes",
          "type": "string",
          "x-aibi-data": true
        },
        "unmapped": {
          "const": "allow",
          "title": "Unmapped",
          "type": "string"
        }
      },
      "required": [
        "all"
      ],
      "title": "Cohort",
      "type": "object"
    },
    "CohortLeaf": {
      "additionalProperties": false,
      "description": "Another cohort of the same document (SPEC §7.2).",
      "properties": {
        "cohort": {
          "maxLength": 64,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Cohort",
          "type": "string"
        },
        "kind": {
          "const": "cohort",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "cohort"
      ],
      "title": "CohortLeaf",
      "type": "object"
    },
    "CoveredLeaf": {
      "additionalProperties": false,
      "description": "Coverage as a predicate (SPEC §6.5).",
      "properties": {
        "kind": {
          "const": "covered",
          "title": "Kind",
          "type": "string"
        },
        "lift": {
          "enum": [
            "strict",
            "assessed"
          ],
          "title": "Lift",
          "type": "string"
        },
        "scope": {
          "additionalProperties": false,
          "maxProperties": 16,
          "minProperties": 1,
          "patternProperties": {
            "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?$": {
              "items": {
                "anyOf": [
                  {
                    "maxLength": 4096,
                    "type": "string"
                  },
                  {
                    "type": [
                      "boolean",
                      "number"
                    ]
                  }
                ]
              },
              "maxItems": 10000,
              "minItems": 1,
              "type": "array"
            }
          },
          "propertyNames": {
            "maxLength": 64
          },
          "title": "Scope",
          "type": "object"
        },
        "table": {
          "maxLength": 256,
          "pattern": "^(?:[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?|[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?:[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?(?:\\.[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?)*)$",
          "title": "Table",
          "type": "string"
        },
        "via": {
          "oneOf": [
            {
              "items": {
                "$ref": "#/$defs/Step"
              },
              "maxItems": 16,
              "type": "array"
            },
            {
              "additionalProperties": false,
              "maxProperties": 64,
              "patternProperties": {
                "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?$": {
                  "items": {
                    "$ref": "#/$defs/Step"
                  },
                  "maxItems": 16,
                  "type": "array"
                }
              },
              "propertyNames": {
                "maxLength": 64
              },
              "type": "object"
            }
          ],
          "title": "Via"
        }
      },
      "required": [
        "kind",
        "table"
      ],
      "title": "CoveredLeaf",
      "type": "object"
    },
    "DocumentJson": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        {
          "items": {
            "$ref": "#/$defs/DocumentJson"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/DocumentJson"
          },
          "type": "object"
        }
      ],
      "description": "Any JSON value but null"
    },
    "ExistsLeaf": {
      "additionalProperties": false,
      "description": "An existence question (SPEC §6.5); ``where`` clauses are ANDed per row of ``table``.",
      "if": {
        "required": [
          "min_count"
        ]
      },
      "properties": {
        "exclude_self": {
          "default": false,
          "title": "Exclude Self",
          "type": "boolean"
        },
        "kind": {
          "const": "exists",
          "title": "Kind",
          "type": "string"
        },
        "lift": {
          "enum": [
            "strict",
            "assessed"
          ],
          "title": "Lift",
          "type": "string"
        },
        "min_count": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Min Count",
          "type": "integer"
        },
        "quantifier": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "enum": [
                    "some",
                    "every"
                  ],
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/SomeAtLeast"
                }
              ]
            },
            {
              "items": {
                "oneOf": [
                  {
                    "enum": [
                      "some",
                      "every"
                    ],
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/SomeAtLeast"
                  }
                ]
              },
              "maxItems": 16,
              "minItems": 1,
              "type": "array"
            }
          ],
          "title": "Quantifier"
        },
        "table": {
          "maxLength": 256,
          "pattern": "^(?:[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?|[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?:[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?(?:\\.[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?)*)$",
          "title": "Table",
          "type": "string"
        },
        "via": {
          "oneOf": [
            {
              "items": {
                "$ref": "#/$defs/Step"
              },
              "maxItems": 16,
              "type": "array"
            },
            {
              "additionalProperties": false,
              "maxProperties": 64,
              "patternProperties": {
                "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?$": {
                  "items": {
                    "$ref": "#/$defs/Step"
                  },
                  "maxItems": 16,
                  "type": "array"
                }
              },
              "propertyNames": {
                "maxLength": 64
              },
              "type": "object"
            }
          ],
          "title": "Via"
        },
        "where": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/ValueLeaf"
              },
              {
                "$ref": "#/$defs/ExistsLeaf"
              },
              {
                "$ref": "#/$defs/CoveredLeaf"
              },
              {
                "$ref": "#/$defs/IdsLeaf"
              },
              {
                "$ref": "#/$defs/CohortLeaf"
              },
              {
                "$ref": "#/$defs/PackLeaf"
              },
              {
                "$ref": "#/$defs/AllClause"
              },
              {
                "$ref": "#/$defs/AnyClause"
              },
              {
                "$ref": "#/$defs/NotClause"
              },
              {
                "$ref": "#/$defs/KnownClause"
              },
              {
                "$ref": "#/$defs/UnknownClause"
              }
            ]
          },
          "maxItems": 256,
          "title": "Where",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "table"
      ],
      "then": {
        "properties": {
          "quantifier": {
            "const": "some"
          }
        }
      },
      "title": "ExistsLeaf",
      "type": "object"
    },
    "IdsLeaf": {
      "additionalProperties": false,
      "description": "An explicit list of unit keys; not allowed inside any ``where`` (SPEC §7.2).",
      "properties": {
        "ids": {
          "items": {
            "oneOf": [
              {
                "maxLength": 4096,
                "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?:[^\\x00-\\x1f\\x7f\\u2028\\u2029]+$",
                "type": "string"
              },
              {
                "$ref": "#/$defs/UnitKey"
              }
            ]
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Ids",
          "type": "array"
        },
        "kind": {
          "const": "ids",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ids"
      ],
      "title": "IdsLeaf",
      "type": "object"
    },
    "KnownClause": {
      "additionalProperties": false,
      "properties": {
        "known": {
          "oneOf": [
            {
              "$ref": "#/$defs/ValueLeaf"
            },
            {
              "$ref": "#/$defs/ExistsLeaf"
            },
            {
              "$ref": "#/$defs/CoveredLeaf"
            },
            {
              "$ref": "#/$defs/IdsLeaf"
            },
            {
              "$ref": "#/$defs/CohortLeaf"
            },
            {
              "$ref": "#/$defs/PackLeaf"
            },
            {
              "$ref": "#/$defs/AllClause"
            },
            {
              "$ref": "#/$defs/AnyClause"
            },
            {
              "$ref": "#/$defs/NotClause"
            },
            {
              "$ref": "#/$defs/KnownClause"
            },
            {
              "$ref": "#/$defs/UnknownClause"
            }
          ],
          "title": "Known"
        }
      },
      "required": [
        "known"
      ],
      "title": "KnownClause",
      "type": "object"
    },
    "NotClause": {
      "additionalProperties": false,
      "properties": {
        "not": {
          "oneOf": [
            {
              "$ref": "#/$defs/ValueLeaf"
            },
            {
              "$ref": "#/$defs/ExistsLeaf"
            },
            {
              "$ref": "#/$defs/CoveredLeaf"
            },
            {
              "$ref": "#/$defs/IdsLeaf"
            },
            {
              "$ref": "#/$defs/CohortLeaf"
            },
            {
              "$ref": "#/$defs/PackLeaf"
            },
            {
              "$ref": "#/$defs/AllClause"
            },
            {
              "$ref": "#/$defs/AnyClause"
            },
            {
              "$ref": "#/$defs/NotClause"
            },
            {
              "$ref": "#/$defs/KnownClause"
            },
            {
              "$ref": "#/$defs/UnknownClause"
            }
          ],
          "title": "Not"
        }
      },
      "required": [
        "not"
      ],
      "title": "NotClause",
      "type": "object"
    },
    "PackLeaf": {
      "additionalProperties": true,
      "description": "A pack leaf, ``<pack id>.<name>``: other members are checked by the pack's schema.",
      "properties": {
        "kind": {
          "maxLength": 129,
          "not": {
            "pattern": "^(?:cohort|compare|core|covered|exists|ids|summary|survival|value)\\."
          },
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?\\.[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?$",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "PackLeaf",
      "type": "object"
    },
    "Range": {
      "additionalProperties": false,
      "minProperties": 1,
      "not": {
        "anyOf": [
          {
            "required": [
              "gt",
              "gte"
            ]
          },
          {
            "required": [
              "lt",
              "lte"
            ]
          }
        ]
      },
      "properties": {
        "gt": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "title": "Gt"
        },
        "gte": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "title": "Gte"
        },
        "lt": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "title": "Lt"
        },
        "lte": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "title": "Lte"
        }
      },
      "title": "Range",
      "type": "object"
    },
    "SomeAtLeast": {
      "additionalProperties": false,
      "description": "``{\"some\": k}``: at least *k* children.",
      "properties": {
        "some": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Some",
          "type": "integer"
        }
      },
      "required": [
        "some"
      ],
      "title": "SomeAtLeast",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "dir": {
          "enum": [
            "up",
            "down"
          ],
          "title": "Dir",
          "type": "string"
        },
        "rel": {
          "maxLength": 512,
          "pattern": "^rel:[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?\\.[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?(?:\\+[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?)*$",
          "title": "Rel",
          "type": "string"
        }
      },
      "required": [
        "rel",
        "dir"
      ],
      "title": "Step",
      "type": "object"
    },
    "UnitKey": {
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?$",
          "title": "Dataset",
          "type": "string"
        },
        "key": {
          "items": {
            "anyOf": [
              {
                "maxLength": 4096,
                "type": "string"
              },
              {
                "type": [
                  "boolean",
                  "number"
                ]
              }
            ]
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Key",
          "type": "array"
        }
      },
      "required": [
        "dataset",
        "key"
      ],
      "title": "UnitKey",
      "type": "object"
    },
    "UnknownClause": {
      "additionalProperties": false,
      "properties": {
        "unknown": {
          "oneOf": [
            {
              "$ref": "#/$defs/ValueLeaf"
            },
            {
              "$ref": "#/$defs/ExistsLeaf"
            },
            {
              "$ref": "#/$defs/CoveredLeaf"
            },
            {
              "$ref": "#/$defs/IdsLeaf"
            },
            {
              "$ref": "#/$defs/CohortLeaf"
            },
            {
              "$ref": "#/$defs/PackLeaf"
            },
            {
              "$ref": "#/$defs/AllClause"
            },
            {
              "$ref": "#/$defs/AnyClause"
            },
            {
              "$ref": "#/$defs/NotClause"
            },
            {
              "$ref": "#/$defs/KnownClause"
            },
            {
              "$ref": "#/$defs/UnknownClause"
            }
          ],
          "title": "Unknown"
        }
      },
      "required": [
        "unknown"
      ],
      "title": "UnknownClause",
      "type": "object"
    },
    "ValueLeaf": {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "values"
          ]
        },
        {
          "required": [
            "range"
          ]
        },
        {
          "required": [
            "op"
          ]
        }
      ],
      "dependentRequired": {
        "op": [
          "value"
        ],
        "value": [
          "op"
        ]
      },
      "description": "A value predicate (SPEC §6.4): exactly one of ``values``, ``range`` or ``op`` + ``value``.",
      "not": {
        "anyOf": [
          {
            "required": [
              "values",
              "range"
            ]
          },
          {
            "required": [
              "values",
              "op"
            ]
          },
          {
            "required": [
              "range",
              "op"
            ]
          }
        ]
      },
      "properties": {
        "column": {
          "maxLength": 256,
          "pattern": "^(?:[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?\\.[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?|[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?:[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?(?:\\.[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?)*)$",
          "title": "Column",
          "type": "string"
        },
        "kind": {
          "const": "value",
          "title": "Kind",
          "type": "string"
        },
        "lift": {
          "enum": [
            "strict",
            "assessed"
          ],
          "title": "Lift",
          "type": "string"
        },
        "match": {
          "enum": [
            "any",
            "all"
          ],
          "title": "Match",
          "type": "string"
        },
        "negate": {
          "default": false,
          "title": "Negate",
          "type": "boolean"
        },
        "op": {
          "enum": [
            "=",
            "!=",
            ">",
            ">=",
            "<",
            "<="
          ],
          "title": "Op",
          "type": "string"
        },
        "quantifier": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "enum": [
                    "some",
                    "every"
                  ],
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/SomeAtLeast"
                }
              ]
            },
            {
              "items": {
                "oneOf": [
                  {
                    "enum": [
                      "some",
                      "every"
                    ],
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/SomeAtLeast"
                  }
                ]
              },
              "maxItems": 16,
              "minItems": 1,
              "type": "array"
            }
          ],
          "title": "Quantifier"
        },
        "range": {
          "$ref": "#/$defs/Range"
        },
        "units": {
          "pattern": "^[!-~]{1,64}$",
          "title": "Units",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": [
                "boolean",
                "number"
              ]
            }
          ],
          "title": "Value"
        },
        "values": {
          "items": {
            "anyOf": [
              {
                "maxLength": 4096,
                "type": "string"
              },
              {
                "type": [
                  "boolean",
                  "number"
                ]
              }
            ]
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        },
        "via": {
          "oneOf": [
            {
              "items": {
                "$ref": "#/$defs/Step"
              },
              "maxItems": 16,
              "type": "array"
            },
            {
              "additionalProperties": false,
              "maxProperties": 64,
              "patternProperties": {
                "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?$": {
                  "items": {
                    "$ref": "#/$defs/Step"
                  },
                  "maxItems": 16,
                  "type": "array"
                }
              },
              "propertyNames": {
                "maxLength": 64
              },
              "type": "object"
            }
          ],
          "title": "Via"
        }
      },
      "required": [
        "kind",
        "column"
      ],
      "title": "ValueLeaf",
      "type": "object"
    },
    "View": {
      "additionalProperties": false,
      "description": "A view. Its cohorts and reference are checked by the document checks, with their paths.",
      "properties": {
        "analysis": {
          "maxLength": 129,
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?\\.[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?$",
          "title": "Analysis",
          "type": "string"
        },
        "cohorts": {
          "items": {
            "maxLength": 64,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Cohorts",
          "type": "array",
          "uniqueItems": true
        },
        "note": {
          "maxLength": 10000,
          "title": "Note",
          "type": "string",
          "x-aibi-data": true
        },
        "overlap": {
          "const": "allow",
          "title": "Overlap",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "$ref": "#/$defs/DocumentJson"
          },
          "title": "Params",
          "type": "object"
        },
        "reference": {
          "maxLength": 64,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Reference",
          "type": "string"
        },
        "unmapped": {
          "const": "allow",
          "title": "Unmapped",
          "type": "string"
        }
      },
      "required": [
        "analysis"
      ],
      "title": "View",
      "type": "object"
    }
  },
  "$id": "document.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An analysis document after ``params`` substitution (SPEC §7.1).",
  "properties": {
    "aibi": {
      "const": "1",
      "title": "Aibi",
      "type": "string"
    },
    "cohorts": {
      "additionalProperties": false,
      "maxProperties": 6,
      "minProperties": 1,
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_]*$": {
          "$ref": "#/$defs/Cohort"
        }
      },
      "propertyNames": {
        "maxLength": 64
      },
      "title": "Cohorts",
      "type": "object"
    },
    "dataset": {
      "maxLength": 136,
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?(?:@(?:[1-9][0-9]*|sha256:[0-9a-f]{64}|draft))?$",
      "title": "Dataset",
      "type": "string"
    },
    "drafted_by": {
      "pattern": "^(?:model:[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?|(?:agent|operator):[^\\x00-\\x1f\\x7f]{1,200})$",
      "title": "Drafted By",
      "type": "string",
      "x-aibi-data": true
    },
    "notes": {
      "maxLength": 10000,
      "title": "Notes",
      "type": "string",
      "x-aibi-data": true
    },
    "packs": {
      "additionalProperties": false,
      "maxProperties": 16,
      "patternProperties": {
        "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?$": {
          "maxLength": 4096,
          "type": "string"
        }
      },
      "propertyNames": {
        "not": {
          "enum": [
            "cohort",
            "compare",
            "core",
            "covered",
            "exists",
            "ids",
            "summary",
            "survival",
            "value"
          ]
        }
      },
      "title": "Packs",
      "type": "object"
    },
    "params": {
      "additionalProperties": false,
      "maxProperties": 256,
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_]*$": {
          "$ref": "#/$defs/DocumentJson"
        }
      },
      "propertyNames": {
        "maxLength": 64
      },
      "title": "Params",
      "type": "object"
    },
    "unit": {
      "maxLength": 256,
      "pattern": "^(?:[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?|[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?:[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?(?:\\.[a-z][a-z0-9]*(?:_[a-z0-9]+)*_?)*)$",
      "title": "Unit",
      "type": "string"
    },
    "views": {
      "items": {
        "$ref": "#/$defs/View"
      },
      "maxItems": 8,
      "title": "Views",
      "type": "array"
    }
  },
  "required": [
    "aibi",
    "unit",
    "cohorts"
  ],
  "title": "Document",
  "type": "object"
}
