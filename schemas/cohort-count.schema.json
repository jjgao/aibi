              }
            }
          },
          "then": {
            "properties": {
              "severity": {
                "const": "info"
              }
            }
          }
        }
      ],
      "description": "``affects`` holds JSON Pointers relative to the output's root, sorted and de-duplicated.",
      "properties": {
        "affects": {
          "items": {
            "maxLength": 16384,
            "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
            "type": "string",
            "x-aibi-data": true
          },
          "title": "Affects",
          "type": "array"
        },
        "code": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,63}\\.[A-Z][A-Z0-9_]{0,63}$"
            },
            {
              "enum": [
                "UNKNOWN_EXCLUDED",
                "INVALID_EXCLUDED",
                "SCOPE_PARTIAL",
                "COVERAGE_PROPOSED",
                "UNCONFIRMED_SEMANTICS",
                "UNMAPPED_COMPARISON",
                "TIME_ORIGIN_MISMATCH",
                "CONFOUNDED_WITH_DATASET",
                "COHORTS_OVERLAP",
                "SMALL_N",
                "PH_VIOLATED",
                "DRAFT_RELEASE",
                "SUPPRESSED",
                "NOT_ESTIMABLE",
                "LIFT_DIFFERS",
                "POOLED_ACROSS_DATASETS"
              ]
            }
          ],
          "maxLength": 129,
          "not": {
            "anyOf": [
              {
                "pattern": "__"
              },
              {
                "pattern": "^(?:cohort|compare|core|cov|covered|dataset|drv|ep|exists|ids|iss|leaf|model|rel|sha256|stat|summary|survival|value)\\."
              }
            ]
          },
          "pattern": "^(?:[a-z][a-z0-9_]{0,63}\\.)?[A-Z][A-Z0-9_]{0,63}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/TextSegment"
              },
              {
                "$ref": "#/$defs/DataSegment"
              }
            ]
          },
          "title": "Message",
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "affects"
      ],
      "title": "Caveat",
      "type": "object"
    },
    "DataSegment": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "maxLength": 200,
          "title": "Data",
          "type": "string",
          "x-aibi-data": true
        },
        "truncated": {
          "const": true,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "data"
      ],
      "title": "DataSegment",
      "type": "object"
    },
    "DenominatorDefinition": {
      "additionalProperties": false,
      "description": "What a proportion's denominator counts (SPEC §8.2).\n\n``counts`` is ``known`` (the units of a cohort for which a predicate is known), ``unit_table``\n(every unit of the unit table) or ``rows``.",
      "properties": {
        "counts": {
          "enum": [
            "known",
            "unit_table",
            "rows"
          ],
          "title": "Counts",
          "type": "string"
        },
        "position": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Position"
        },
        "predicate": {
          "anyOf": [
            {
              "pattern": "^leaf:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Predicate"
        }
      },
      "required": [
        "position",
        "predicate",
        "counts"
      ],
      "title": "DenominatorDefinition",
      "type": "object"
    },
    "Disclosure": {
      "additionalProperties": false,
      "description": "The effective disclosure setting of an output (SPEC §8.4).",
      "properties": {
        "min_cell_count": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 2,
              "type": "integer"
            },
