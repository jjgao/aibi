      "properties": {
        "ci": {
          "$ref": "#/$defs/Interval"
        },
        "denominator": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Denominator",
          "x-aibi-computed": true
