      "required": [
        "min_cell_count"
      ],
      "title": "Disclosure",
      "type": "object"
    },
    "ExclusionReason": {
      "description": "Why an analysis left out a unit or row (SPEC §6.6): the reasons, and two more.",
      "enum": [
        "NOT_ASSESSED",
        "NOT_COVERED",
        "NO_INFORMATION",
        "NO_PARENT",
        "OUT_OF_SCOPE",
        "NO_ROWS",
        "NOT_APPLICABLE",
        "INVALID_VALUE"
