{
  "$defs": {
    "Caveat": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "UNKNOWN_EXCLUDED"
              }
            }
          },
          "then": {
            "properties": {
              "severity": {
                "const": "warn"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "INVALID_EXCLUDED"
              }
            }
          },
          "then": {
            "properties": {
              "severity": {
                "const": "warn"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "SCOPE_PARTIAL"
              }
            }
          },
          "then": {
            "properties": {
              "severity": {
                "const": "warn"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "COVERAGE_PROPOSED"
              }
            }
          },
          "then": {
            "properties": {
              "severity": {
                "const": "warn"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "UNCONFIRMED_SEMANTICS"
              }
            }
          },
          "then": {
            "properties": {
              "severity": {
                "const": "warn"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "UNMAPPED_COMPARISON"
              }
            }
          },
          "then": {
            "properties": {
              "severity": {
                "const": "warn"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "TIME_ORIGIN_MISMATCH"
              }
            }
          },
          "then": {
            "properties": {
              "severity": {
                "const": "block"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "CONFOUNDED_WITH_DATASET"
              }
            }
          },
          "then": {
            "properties": {
              "severity": {
                "const": "warn"
              }
            }
          }
        },
        {
