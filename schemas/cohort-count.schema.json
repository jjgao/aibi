              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Excluded",
          "x-aibi-computed": true
        },
        "not_estimable": {
          "additionalProperties": false,
          "minProperties": 1,
          "patternProperties": {
            "^(?:/(?:[^~/]|~[01])*)+$": {
