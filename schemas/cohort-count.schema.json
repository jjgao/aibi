      },
      "required": [
        "method",
        "level",
        "low",
        "high"
      ],
      "title": "Interval",
      "type": "object"
    },
    "Issuance": {
      "additionalProperties": false,
      "description": "One time an output was produced. ``values_from`` names the issuance whose SQL produced\nthe values: this one, or for a cache hit the one that filled the cache.",
      "properties": {
