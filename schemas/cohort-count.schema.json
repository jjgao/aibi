                  "minimum": 0,
                  "type": "integer"
                }
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unknown By Leaf",
          "x-aibi-computed": true
        },
        "unknown_by_reason": {
