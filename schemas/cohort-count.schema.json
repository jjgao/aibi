            },
            "required": [
              "not_estimable"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "not_estimable": {
                "required": [
                  "/excluded"
                ]
              }
            },
            "required": [
              "not_estimable"
            ]
          },
          "then": {
            "properties": {
              "excluded": {
                "type": "null"
              }
            },
            "required": [
              "excluded"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "ci": {
                "properties": {
                  "low": {
                    "type": "null"
                  }
                },
                "required": [
                  "low"
                ]
              }
            },
            "required": [
              "ci"
            ]
          },
          "then": {
            "properties": {
              "not_estimable": {
                "required": [
                  "/ci/low"
                ]
              }
            },
            "required": [
              "not_estimable"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "not_estimable": {
                "required": [
                  "/ci/low"
                ]
              }
            },
            "required": [
              "not_estimable"
            ]
          },
          "then": {
            "properties": {
              "ci": {
                "properties": {
                  "low": {
                    "type": "null"
                  }
                },
                "required": [
                  "low"
                ]
              }
            },
            "required": [
              "ci"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "ci": {
                "properties": {
                  "high": {
                    "type": "null"
                  }
                },
                "required": [
                  "high"
                ]
              }
            },
            "required": [
              "ci"
            ]
          },
          "then": {
            "properties": {
              "not_estimable": {
                "required": [
                  "/ci/high"
                ]
              }
            },
            "required": [
              "not_estimable"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "not_estimable": {
                "required": [
                  "/ci/high"
                ]
              }
            },
            "required": [
              "not_estimable"
            ]
          },
          "then": {
            "properties": {
              "ci": {
                "properties": {
                  "high": {
                    "type": "null"
                  }
                },
                "required": [
                  "high"
                ]
              }
            },
            "required": [
              "ci"
            ]
          }
        },
        {
          "properties": {
            "not_estimable": {
              "propertyNames": {
                "enum": [
                  "/estimate",
                  "/numerator",
                  "/denominator",
                  "/excluded",
                  "/ci/low",
                  "/ci/high"
                ]
              }
            }
          }
        },
        {
          "properties": {
            "not_estimable": {
              "properties": {
                "/denominator": {
                  "const": "suppressed"
                },
                "/excluded": {
                  "const": "suppressed"
                },
                "/numerator": {
                  "const": "suppressed"
                }
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "not_estimable": {
                "properties": {
                  "/estimate": {
                    "const": "suppressed"
                  }
                },
                "required": [
                  "/estimate"
                ]
              }
            },
            "required": [
              "not_estimable"
            ]
          },
          "if": {
            "properties": {
              "denominator": {
                "type": "integer"
              },
              "numerator": {
                "type": "integer"
              }
            },
            "required": [
              "numerator",
              "denominator"
            ]
          },
          "then": {
            "properties": {
              "not_estimable": {
                "properties": {
                  "/ci/high": {
                    "not": {
                      "const": "suppressed"
                    }
                  },
                  "/ci/low": {
                    "not": {
                      "const": "suppressed"
                    }
                  },
                  "/estimate": {
                    "not": {
                      "const": "suppressed"
                    }
                  }
                }
              }
            }
          }
        }
