          },
          "title": "Not Estimable",
          "type": "object"
        },
        "numerator": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Numerator",
          "x-aibi-computed": true
        }
      },
      "required": [
        "estimate",
        "numerator",
        "denominator",
        "denominator_definition"
      ],
      "title": "Proportion",
      "type": "object"
    },
    "Reason": {
      "description": "Why a truth value is UNKNOWN (SPEC §6.3). An UNKNOWN always has at least one.",
      "enum": [
        "NOT_ASSESSED",
        "NOT_COVERED",
        "NO_INFORMATION",
        "NO_PARENT",
        "OUT_OF_SCOPE",
        "NO_ROWS"
      ],
      "title": "Reason",
      "type": "string"
    },
    "ReleaseRef": {
      "additionalProperties": false,
      "description": "A release an output drew on. The label is recorded beside the manifest, never hashed.",
      "else": {
        "properties": {
          "label": {
            "type": "integer"
          }
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "draft"
          }
        }
      },
      "properties": {
        "dataset": {
          "maxLength": 64,
          "not": {
            "pattern": "__"
          },
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Dataset",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "const": "draft",
              "type": "string"
            }
          ],
          "title": "Label"
        },
        "manifest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifest",
          "type": "string"
        },
        "status": {
          "enum": [
            "published",
            "draft"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "dataset",
        "label",
        "manifest",
        "status"
      ],
      "then": {
        "properties": {
          "label": {
            "const": "draft"
          }
        }
      },
      "title": "ReleaseRef",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "info",
        "warn",
        "block"
      ],
      "title": "Severity",
      "type": "string"
    },
    "TextSegment": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "TextSegment",
      "type": "object"
    }
  },
  "$id": "cohort-count.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "releases": {
            "contains": {
              "properties": {
                "status": {
                  "const": "draft"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "issuance": {
            "properties": {
              "cache_hit": {
                "const": false
              }
            }
          }
        }
      }
    }
  ],
  "description": "A cohort's count, as ``count_cohort`` returns it (SPEC §8.1).",
  "properties": {
    "caveats": {
      "allOf": [
        {
          "items": {
            "not": {
              "properties": {
                "code": {
                  "enum": [
                    "COHORTS_OVERLAP",
                    "CONFOUNDED_WITH_DATASET",
                    "INVALID_EXCLUDED"
                  ]
                }
              }
            },
            "properties": {
              "affects": {
                "const": [
                  "/population"
                ]
              }
            }
          }
        }
      ],
      "items": {
        "$ref": "#/$defs/Caveat"
      },
      "title": "Caveats",
      "type": "array"
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Digest",
      "type": "string"
    },
    "disclosure": {
      "$ref": "#/$defs/Disclosure"
    },
    "id": {
      "pattern": "^drv:[0-9a-f]{64}$",
      "title": "Id",
      "type": "string"
    },
    "issuance": {
      "$ref": "#/$defs/Issuance"
    },
    "population": {
      "$ref": "#/$defs/Population"
    },
    "readback": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/TextSegment"
          },
          {
            "$ref": "#/$defs/DataSegment"
          }
        ]
      },
      "title": "Readback",
      "type": "array"
    },
    "releases": {
      "items": {
        "$ref": "#/$defs/ReleaseRef"
      },
      "minItems": 1,
      "title": "Releases",
      "type": "array"
    },
    "size": {
      "$ref": "#/$defs/Proportion",
      "allOf": [
        {
          "not": {
            "required": [
              "excluded"
            ]
          },
          "properties": {
            "denominator": {
              "type": "integer"
            },
            "denominator_definition": {
              "const": {
                "counts": "unit_table",
                "position": null,
                "predicate": null
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "id",
    "digest",
    "population",
    "size",
    "disclosure",
    "readback",
    "caveats",
    "releases",
    "issuance"
  ],
  "title": "CohortCount",
  "type": "object"
}
