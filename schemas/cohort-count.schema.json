              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "SMALL_N"
              }
            }
          },
          "then": {
            "properties": {
              "severity": {
                "const": "warn"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "PH_VIOLATED"
              }
            }
          },
          "then": {
            "properties": {
              "severity": {
                "const": "warn"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "DRAFT_RELEASE"
              }
            }
