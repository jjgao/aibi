      "title": "ExclusionReason",
      "type": "string"
    },
    "Interval": {
      "additionalProperties": false,
      "description": "A confidence interval. ``method`` names the method as the analysis entry does (§9.1).",
      "properties": {
        "high": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
