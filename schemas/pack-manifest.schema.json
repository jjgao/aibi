{
  "$id": "pack-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "``results_version`` is bumped whenever a change to the pack could change outputs; it is\nhashed into ids, so an upgrade that changes nothing changes no id (SPEC §7.6, §10.1).",
  "properties": {
    "id": {
      "maxLength": 64,
      "not": {
        "anyOf": [
          {
            "pattern": "__"
          },
          {
            "enum": [
              "cohort",
              "compare",
              "core",
              "cov",
              "covered",
              "dataset",
              "drv",
              "ep",
              "exists",
              "ids",
              "iss",
              "leaf",
              "model",
              "rel",
              "sha256",
              "stat",
              "summary",
              "survival",
              "value"
            ]
          }
        ]
      },
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "requires_core": {
      "maxLength": 1200,
      "pattern": "^(?:~=|===|==|!=|<=|>=|<|>)[0-9A-Za-z.*+!_-]{1,64}(?:,(?:~=|===|==|!=|<=|>=|<|>)[0-9A-Za-z.*+!_-]{1,64}){0,15}$",
      "title": "Requires Core",
      "type": "string"
    },
    "results_version": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Results Version",
      "type": "integer"
    },
    "version": {
      "maxLength": 64,
      "pattern": "^(?:[0-9]+!)?[0-9]+(?:\\.[0-9]+)*(?:(?:a|b|rc)[0-9]+)?(?:\\.post[0-9]+)?(?:\\.dev[0-9]+)?(?:\\+[a-z0-9]+(?:\\.[a-z0-9]+)*)?$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "results_version",
    "requires_core"
  ],
  "title": "PackManifest",
  "type": "object"
}
