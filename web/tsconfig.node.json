{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "paths": { "openapi-typescript": ["./scripts/openapi-typescript.d.ts"] }
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "eslint.config.mjs",
    "plugins",
    "scripts",
    "tests/gates",
    "tests/unit",
    "src/env.d.ts",
    "e2e"
  ]
}
